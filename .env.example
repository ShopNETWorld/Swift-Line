# ──────────────────────────────────────────────────────────────────
# Swift Line Worldwide Courier — Environment Variables
# Copy this file to .env for local development.
# Add all variables below to your Vercel project dashboard:
#   Settings -> Environment Variables
# ──────────────────────────────────────────────────────────────────

# JWT Secret -- use a long random string in production
JWT_SECRET=swift-line-jwt-secret-change-in-production

# Supabase -- from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SMTP Email (optional -- leave blank to use console log fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Server port (local dev only -- Vercel ignores this)
PORT=5000

# Frontend URL -- set to your Vercel deployment URL in production
# e.g. https://swift-line.vercel.app
FRONTEND_URL=http://localhost:3000
